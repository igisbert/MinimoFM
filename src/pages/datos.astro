---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main>
    <a href="/" class="back-button">Volver al reproductor</a>
    <div id="notification-container"></div>
    <h1>Gestiona los datos de este dispositivo</h1>

    <section class="data-section">
      <h2>Episodios escuchados</h2>

      <div class="card">
        <h3>Importar</h3>
        <p>Pega el contenido de tu copia de seguridad aquí y pulsa guardar.</p>
        <textarea
          id="import-listened"
          rows="3"
          placeholder="Pega aquí tus datos..."></textarea>
        <button class="import-button" data-type="listened">Guardar datos</button>
      </div>

      <div class="card">
        <h3>Exportar</h3>
        <p>
          Pulsa el botón para generar tu copia de seguridad. Cópiala y guárdala en
          un lugar seguro.
        </p>
        <button class="export-button" data-type="listened">Generar copia de seguridad</button>
        <div class="export-container hidden">
          <pre><code class="export-data" /></pre>
          <button class="copy-button">Copiar</button>
        </div>
      </div>

      <div class="card">
        <h3>Eliminar</h3>
        <p>
          Esta acción eliminará permanentemente el progreso de episodios
          escuchados en este dispositivo.
        </p>
        <button class="delete-button danger" data-type="listened">Eliminar todos los datos</button>
        <div class="delete-confirmation hidden">
          <p>¿Estás seguro? Esta acción no se puede deshacer.</p>
          <button class="confirm-delete-button danger" data-type="listened">Sí, eliminar</button>
          <button class="cancel-delete-button">Cancelar</button>
        </div>
      </div>
    </section>

    <section class="data-section">
      <h2>Episodios guardados</h2>

      <div class="card">
        <h3>Importar</h3>
        <p>Pega el contenido de tu copia de seguridad aquí y pulsa guardar.</p>
        <textarea
          id="import-bookmarks"
          rows="3"
          placeholder="Pega aquí tus datos..."></textarea>
        <button class="import-button" data-type="bookmarks">Guardar datos</button>
      </div>

      <div class="card">
        <h3>Exportar</h3>
        <p>
          Pulsa el botón para generar tu copia de seguridad. Cópiala y guárdala en
          un lugar seguro.
        </p>
        <button class="export-button" data-type="bookmarks">Generar copia de seguridad</button>
        <div class="export-container hidden">
          <pre><code class="export-data" /></pre>
          <button class="copy-button">Copiar</button>
        </div>
      </div>

      <div class="card">
        <h3>Eliminar</h3>
        <p>
          Esta acción eliminará permanentemente todos los episodios guardados en
          este dispositivo.
        </p>
        <button class="delete-button danger" data-type="bookmarks">Eliminar todos los datos</button>
        <div class="delete-confirmation hidden">
          <p>¿Estás seguro? Esta acción no se puede deshacer.</p>
          <button class="confirm-delete-button danger" data-type="bookmarks">Sí, eliminar</button>
          <button class="cancel-delete-button">Cancelar</button>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  main {
    max-width: 800px;
    margin: 2rem auto;
    padding: 1rem;
  }

  .back-button {
    display: block;
    margin-bottom: 2rem;
    text-align: center;
  }

  .back-button {
    color: var(--text-primary);
    text-decoration: none;
    font-weight: bold;
    font-size: 1.5rem;
    cursor: pointer;
    background: var(--bg-pill);
    border: 1px solid var(--border-subtle);
    padding: 1rem 1.5rem;
    border-radius: 1rem;
    transition: background-color 0.2s, border-color 0.2s, transform 0.2s;
  }

  .back-button:hover {
    background-color: var(--bg-pill-hover);
    border-color: var(--border-hover);
    text-decoration: none;
  }

  .back-button:active {
    transform: scale(0.98);
    color: var(--text-primary);
  }
  .back-button:visited {
    color: var(--text-primary);
  }

  h1 {
    text-align: center;
    margin-bottom: 2rem;
    color: var(--text-primary);
  }

  .data-section {
    margin-bottom: 3rem;
  }

  .data-section h2 {
    text-align: center;
    color: var(--accent);
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--border-subtle);
  }

  .card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1rem;
  }

  h3 {
    margin-top: 0;
    color: var(--text-primary);
  }

  p {
    color: var(--text-muted);
  }

  button {
    padding: 0.6rem 1.2rem;
    border: none;
    border-radius: 6px;
    background-color: var(--accent);
    color: var(--accent-on);
    font-weight: bold;
    cursor: pointer;
    margin-top: 0.5rem;
    transition: filter 0.2s, transform 0.2s;
  }

  button:hover {
    filter: brightness(1.1);
  }

  button:active {
    transform: scale(0.98);
  }

  button.danger {
    background-color: #c0392b;
    color: white;
  }

  textarea {
    width: 100%;
    padding: 0.5rem;
    border-radius: 6px;
    background-color: var(--bg-app);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    margin-top: 0.5rem;
    box-sizing: border-box;
    transition: border-color 0.2s;
  }

  textarea:focus {
    border-color: var(--border-hover);
    outline: none;
  }

  pre {
    background-color: var(--bg-app);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 1rem;
    border-radius: 6px;
    white-space: pre-wrap;
    word-wrap: break-word;
    margin-top: 1rem;
  }

  .hidden {
    display: none;
  }

  .delete-confirmation {
    margin-top: 1rem;
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .delete-confirmation.hidden {
    display: none;
  }

  .export-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .export-container.hidden {
    display: none;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const STORAGE_KEYS = {
      listened: "listenedEpisodes",
      bookmarks: "bookmarkedEpisodes",
    };

    // --- Notification System ---
    const notificationContainer = document.getElementById(
      "notification-container"
    );

    function showNotification(
      message: string,
      type = "success",
      duration = 3000
    ) {
      if (!notificationContainer) return;

      const notification = document.createElement("div");
      notification.className = `notification ${type}`;
      notification.textContent = message;

      notificationContainer.appendChild(notification);

      requestAnimationFrame(() => {
        notification.classList.add("show");
      });

      setTimeout(() => {
        notification.classList.remove("show");
        notification.addEventListener(
          "transitionend",
          () => notification.remove(),
          { once: true }
        );
      }, duration);
    }

    // --- Import ---
    document.querySelectorAll(".import-button").forEach((button) => {
      button.addEventListener("click", () => {
        const type = (button as HTMLElement).dataset.type as keyof typeof STORAGE_KEYS;
        const textarea = document.getElementById(
          `import-${type}`
        ) as HTMLTextAreaElement;
        const data = textarea?.value;

        if (!data) {
          showNotification("El área de texto está vacía.", "error");
          return;
        }

        try {
          const parsedData = JSON.parse(data);
          if (Array.isArray(parsedData)) {
            localStorage.setItem(STORAGE_KEYS[type], JSON.stringify(parsedData));
            showNotification("Datos importados correctamente.", "success");
            textarea.value = "";
          } else {
            showNotification(
              "Error: Los datos importados deben ser un array.",
              "error"
            );
          }
        } catch {
          showNotification(
            "Error al procesar los datos. Asegúrate de que es un JSON válido.",
            "error"
          );
        }
      });
    });

    // --- Export ---
    document.querySelectorAll(".export-button").forEach((button) => {
      button.addEventListener("click", () => {
        const type = (button as HTMLElement).dataset.type as keyof typeof STORAGE_KEYS;
        const data = localStorage.getItem(STORAGE_KEYS[type]);
        const card = button.closest(".card");
        const exportContainer = card?.querySelector(".export-container");
        const exportData = card?.querySelector(".export-data");

        if (data && exportData && exportContainer) {
          exportData.textContent = JSON.stringify(JSON.parse(data), null, 2);
          exportContainer.classList.remove("hidden");
        } else {
          showNotification("No hay datos para exportar.", "error");
        }
      });
    });

    // --- Copy ---
    document.querySelectorAll(".copy-button").forEach((button) => {
      button.addEventListener("click", () => {
        const exportData = button.closest(".card")?.querySelector(".export-data");
        if (exportData?.textContent) {
          navigator.clipboard
            .writeText(exportData.textContent)
            .then(() => showNotification("¡Copiado al portapapeles!", "success"))
            .catch(() => showNotification("No se pudo copiar", "error"));
        }
      });
    });

    // --- Delete ---
    document.querySelectorAll(".delete-button").forEach((button) => {
      button.addEventListener("click", () => {
        const confirmation = button.closest(".card")?.querySelector(".delete-confirmation");
        confirmation?.classList.remove("hidden");
      });
    });

    document.querySelectorAll(".cancel-delete-button").forEach((button) => {
      button.addEventListener("click", () => {
        const confirmation = button.closest(".delete-confirmation");
        confirmation?.classList.add("hidden");
      });
    });

    document.querySelectorAll(".confirm-delete-button").forEach((button) => {
      button.addEventListener("click", () => {
        const type = (button as HTMLElement).dataset.type as keyof typeof STORAGE_KEYS;
        const card = button.closest(".card");
        const exportContainer = card?.querySelector(".export-container");
        const confirmation = card?.querySelector(".delete-confirmation");

        localStorage.removeItem(STORAGE_KEYS[type]);
        showNotification("Datos eliminados correctamente.", "success");
        confirmation?.classList.add("hidden");
        exportContainer?.classList.add("hidden");
      });
    });
  });
</script>
