---
import { X } from "@lucide/astro";
---

<nav>
  <button id="close-menu-button">
    <X class="close-icon" />
  </button>
  <ul>
    <li>
      <a href="/datos"
        >Gestiona los datos de los episodios en este dispositivo</a
      >
    </li>
  </ul>
</nav>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    width: min(25rem, 75%);
    border-right: 1px solid var(--border-subtle);
    height: 100lvh;
    background-color: var(--bg-header);
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    transform: translateX(-100%);
    transition: transform 0.3s ease-in-out;
    z-index: 50;
    padding: 6rem 3rem;
  }

  button {
    cursor: pointer;
    background: var(--bg-pill);
    border: 1px solid var(--border-subtle);
    color: var(--accent);
    border-radius: 50%;
    padding: 0.5rem;
    font-size: 1rem;
    font-weight: bold;
    width: 3rem;
    height: 3rem;
    display: flex;
    justify-content: center;
    align-items: center;
    position: fixed;
    left: 1rem;
    top: 1.5rem;
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }

  button:hover {
    background-color: var(--bg-pill-hover);
    border-color: var(--border-hover);
  }

  .close-icon {
    width: 1.5rem;
    height: 1.5rem;
  }

  ul {
    padding: 0;
    margin: 0;
  }

  nav.is-open {
    transform: translateX(0);
  }

  a {
    color: var(--text-primary);
    text-decoration: none;
    font-size: 1.25rem;
    font-weight: bold;
    text-wrap: balance;
    transition: color 0.2s;
  }

  a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
