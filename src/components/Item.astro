---
import {
  Play,
  Pause,
  Ear,
  EarOff,
  Loader2,
  Bookmark,
  BookmarkOff,
} from "@lucide/astro";

export interface Props {
  id: string;
  title: string;
  audioUrl: string;
  date: string;
}

const { id, title, audioUrl, date } = Astro.props;
---

<aside>
  <h3>{title}</h3>
  <p>{date}</p>
  <button class="play-button" data-audio-url={audioUrl} data-episode-id={id}>
    <Play class="play-icon" />
    <Pause class="pause-icon" />
    <Loader2 class="loader-icon" />
  </button>
  <div class="listened-icon-container" data-episode-id={id}>
    <Ear class="ear-icon" />
    <EarOff class="ear-off-icon" />
  </div>
  <div class="bookmark-icon-container" data-episode-id={id}>
    <button class="bookmark-button" data-episode-id={id}>
      <Bookmark class="bookmark-icon" />
      <BookmarkOff class="bookmark-off-icon" />
    </button>
  </div>
</aside>

<style>
  aside {
    background: var(--bg-card);
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: 0.5rem;
    padding: 1rem;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  h3 {
    margin: 0.5rem 0;
    width: 95%;
    font-size: 1.15rem;
    color: var(--text-primary);
  }

  p {
    color: var(--text-faint);
    margin: 0.5rem 0 1rem 0rem;
  }

  .play-button {
    cursor: pointer;
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    background: var(--accent);
    border: none;
    border-radius: 50%;
    padding: 0.5rem;
    font-size: 1rem;
    font-weight: bold;
    width: 3rem;
    height: 3rem;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 5;
    transition:
      transform 0.2s,
      filter 0.2s;
  }

  button:hover {
    transform: scale(1.05);
    filter: brightness(1.1);
  }

  .play-icon,
  .pause-icon,
  .loader-icon {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--accent-on);
  }

  .play-button .pause-icon,
  .play-button .loader-icon {
    display: none;
  }

  .play-button.playing .play-icon {
    display: none;
  }

  .play-button.playing .pause-icon {
    display: block;
  }

  .play-button.loading .play-icon,
  .play-button.loading .pause-icon {
    display: none;
  }

  .play-button.loading .loader-icon {
    display: block;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }


  .listened-icon-container {
    position: relative;
    width: 2rem;
    height: 2rem;
  }

  .ear-icon,
  .ear-off-icon {
    width: 2rem;
    height: 2rem;
    transition: color 0.2s;
  }

  .listened-icon-container .ear-icon {
    display: none;
    color: var(--accent);
  }

  .listened-icon-container .ear-off-icon {
    display: block;
    color: var(--text-disabled);
  }

  .listened-icon-container.is-listened .ear-icon {
    display: block;
  }

  .listened-icon-container.is-listened .ear-off-icon {
    display: none;
  }


  .bookmark-icon-container {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .bookmark-button {
    cursor: pointer;
    background-color: transparent;
    border: 0;
    padding: 0.25rem;
    display: flex;
    transition: transform 0.2s, filter 0.2s;
  }

  .bookmark-icon,
  .bookmark-off-icon {
    width: 1.25rem;
    height: 1.25rem;
    transition: color 0.2s;
  }

  .bookmark-icon-container .bookmark-icon {
    display: none;
    color: var(--accent);
  }

  .bookmark-icon-container .bookmark-off-icon {
    display: block;
    color: var(--text-disabled);
  }

  .bookmark-icon-container.is-bookmarked .bookmark-icon {
    display: block;
  }

  .bookmark-icon-container.is-bookmarked .bookmark-off-icon {
    display: none;
  }
</style>
