---
import Item from "./Item.astro";
import data from "../data/episodes.json";
---

<section id="grid">
  {data.map((episode) => <Item {...episode} />)}
</section>

<style>
  section {
    max-width: 1600px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    padding: 1.5rem;
    gap: 1.5rem;
    margin-bottom: var(--player-height);
    @media (width < 800px) {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function setupEpisodeListeners() {
    const grid = document.getElementById("grid");
    if (!grid) return;

    // --- Listened ---
    const getListenedEpisodes = () => {
      return JSON.parse(localStorage.getItem("listenedEpisodes") || "[]");
    };

    const updateListenedIcon = (container: HTMLElement, episodeId: string) => {
      if (getListenedEpisodes().includes(episodeId)) {
        container.classList.add("is-listened");
      } else {
        container.classList.remove("is-listened");
      }
    };

    const updateAllListenedIcons = () => {
      const containers = grid.querySelectorAll(
        ".listened-icon-container",
      ) as NodeListOf<HTMLElement>;
      containers.forEach((container) => {
        const episodeId = container.dataset.episodeId;
        if (episodeId) updateListenedIcon(container, episodeId);
      });
    };

    updateAllListenedIcons();

    document.addEventListener("episodeListened", (event) => {
      const { id } = (event as CustomEvent).detail;
      const container = grid.querySelector(
        `.listened-icon-container[data-episode-id="${id}"]`,
      );
      if (container) updateListenedIcon(container as HTMLElement, id);
    });

    // --- Bookmarks ---
    const getBookmarkedEpisodes = () => {
      return JSON.parse(localStorage.getItem("bookmarkedEpisodes") || "[]");
    };

    const saveBookmarkedEpisodes = (episodes: string[]) => {
      localStorage.setItem("bookmarkedEpisodes", JSON.stringify(episodes));
    };

    const updateBookmarkIcon = (container: HTMLElement, episodeId: string) => {
      if (getBookmarkedEpisodes().includes(episodeId)) {
        container.classList.add("is-bookmarked");
      } else {
        container.classList.remove("is-bookmarked");
      }
    };

    const updateAllBookmarkIcons = () => {
      const containers = grid.querySelectorAll(
        ".bookmark-icon-container",
      ) as NodeListOf<HTMLElement>;
      containers.forEach((container) => {
        const episodeId = container.dataset.episodeId;
        if (episodeId) updateBookmarkIcon(container, episodeId);
      });
    };

    updateAllBookmarkIcons();

    grid.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const button = target.closest(".bookmark-button") as HTMLElement | null;
      if (!button) return;

      const episodeId = button.dataset.episodeId;
      if (!episodeId) return;

      const bookmarked = getBookmarkedEpisodes();
      const index = bookmarked.indexOf(episodeId);
      if (index === -1) {
        bookmarked.push(episodeId);
      } else {
        bookmarked.splice(index, 1);
      }
      saveBookmarkedEpisodes(bookmarked);

      const container = grid.querySelector(
        `.bookmark-icon-container[data-episode-id="${episodeId}"]`,
      );
      if (container) updateBookmarkIcon(container as HTMLElement, episodeId);

      // Notify Controls to re-apply filters
      document.dispatchEvent(new CustomEvent("bookmarkChanged"));
    });
  }

  document.addEventListener("DOMContentLoaded", setupEpisodeListeners);
</script>
